{
  "expo": {
    "name": "Netsol Cliente",
    "slug": "netsol-cliente",
    "version": "4.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "netsol-cliente",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netsol"
    },
    "android": {
      "package": "com.netsol",
      "versionCode":4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#d9252a"
      },
      "permissions": [
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#d9252a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "kotlinVersion": "2.0.21",
            "newArchEnabled": false,
            "enableMinifyInReleaseBuilds": true,
"enableShrinkResourcesInReleaseBuilds": true,
"extraProguardRules": "-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.reactnativecommunity.webview.** { *; }\n-keep class com.th3rdwave.safeareacontext.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4dcfd9c9-e165-4ad9-83fa-415adb7e36d8"
      },
      "router": {}
    },
    "owner": "emesonmikael"
  }
}
